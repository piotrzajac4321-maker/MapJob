{
  "manifest_version": 3,
  "name": "MapJob FB Poster",
  "version": "0.1.0",
  "description": "Półautomatyczne masowe postowanie ogłoszeń na grupy Facebook. Wymaga konta MapJob FB Poster.",
  "default_locale": "pl",
  "permissions": ["storage", "scripting", "alarms", "notifications", "clipboardWrite", "tabs"],
  "host_permissions": ["*://*.facebook.com/*", "https://*.supabase.co/*"],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "MapJob FB Poster"
  },
  "content_scripts": [
    {
      "matches": ["*://www.facebook.com/groups/feed/*", "*://www.facebook.com/groups/joins/*"],
      "js": ["src/content/fb-groups-scrape.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.facebook.com/groups/*"],
      "exclude_matches": ["*://www.facebook.com/groups/feed/*", "*://www.facebook.com/groups/joins/*"],
      "js": ["src/content/fb-composer-paste.ts", "src/content/fb-publish-detect.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/callback.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
