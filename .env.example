# =============================================================================
# MapJob FB Poster — env example
# Skopiuj do apps/web/.env.local i apps/extension/.env (różne podzbiory zmiennych)
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (dedykowany projekt, NIE ten od głównego MapJob.pl)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Tylko po stronie serwera (Next.js Server Actions / Route Handlers / Edge Fns)
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# -----------------------------------------------------------------------------
# Anthropic (Claude) — TYLKO w secrets Supabase Edge Functions
# Nigdy nie commituj, nigdy nie wysyłaj do klienta/extension
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# -----------------------------------------------------------------------------
# Custom JWT dla Chrome extension (issue-extension-token Edge Function)
# Wygeneruj: openssl rand -hex 32
# -----------------------------------------------------------------------------
EXTENSION_TOKEN_SECRET=""

# -----------------------------------------------------------------------------
# Chrome Extension (apps/extension/.env) — używa prefiksu VITE_
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"
VITE_WEB_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Web app — publiczna baza URL (do generowania linków zaproszeń itp.)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_EXTENSION_ID=""
